# Generated artifacts. Nothing here is reproducible from the source, and a
# stale one can shadow the source it was built from -- see
# tests/test_repo_hygiene.py for the incident that prompted this.
__pycache__/
*.py[cod]
*.so
*.egg-info/
# The READMEs tell people to build the environment at .venv/ inside the
# repository. Nothing ignored it, so `git status` offered a whole virtual
# environment as untracked -- and the language guard read its contents.
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
