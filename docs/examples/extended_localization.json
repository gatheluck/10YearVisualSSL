{
  "task": "extended_structured",
  "profile": "capture_extended_components",
  "dataset": "seven_scenes",
  "seed": 0,
  "device": "cuda",
  "data_root": "/data/seven_scenes",
  "samples": "/data/seven_scenes/samples.json",
  "transform_profile": "captured_structured_v1",
  "adaptation": "frozen",
  "reader_profile": null,
  "backbone": {
    "kind": "siglip2_g",
    "arch": "siglip2_g",
    "encoder": "/models/vision-encoder",
    "img_size": 384,
    "patch_size": 16
  },
  "probe": {
    "epochs": 30,
    "batch_size": 2,
    "num_workers": 2
  },
  "execution": {
    "accumulation_steps": 4,
    "precision": "fp32",
    "tail_policy": "discard"
  }
}
