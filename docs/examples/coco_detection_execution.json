{
  "task": "coco_detection",
  "seed": 0,
  "device": "cuda",
  "data_root": "/data/coco_detection",
  "backbone": {
    "kind": "siglip2_g",
    "arch": "released",
    "encoder": "/models/local-vision-snapshot",
    "img_size": 384,
    "patch_size": 16
  },
  "detector": {
    "epochs": 12,
    "batch_size": 1,
    "lr": "protocol",
    "num_workers": 4,
    "min_size": 800,
    "max_size": 1333,
    "anchor_sizes": [
      32,
      64,
      128,
      256
    ],
    "max_train_samples": 0,
    "max_val_samples": 0,
    "max_steps_per_epoch": 0
  },
  "profile": "capture_basic5_components",
  "adaptation": "frozen",
  "optimizer_profile": "basic5_frozen_v1",
  "execution": {
    "profile": "captured_dense_v1",
    "accumulation_steps": 16,
    "precision": "bf16",
    "tail_policy": "discard"
  },
  "scheduler_profile": "basic5_reference_schedule_v1",
  "detector_profile": "captured_native_detection_v1"
}
