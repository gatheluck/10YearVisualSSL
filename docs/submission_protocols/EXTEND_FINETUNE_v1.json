  "dataset_resolution": "Resolve every dataset entry from EXTEND_LINEAR_v1 and retain its path, split, epoch count, task head, loss, metric, and dataset-specific override. Apply the matching full-fine-tuning recipe above. Do not replace the inherited task head with a stronger decoder.",
  "reporting": {
    "checkpoint_rule": "final scheduled epoch",
    "aggregation": "single seed-0 score; no mean or standard deviation",
    "required_metadata": [
      "logical and physical job IDs",
      "checkpoint",
      "dataset/version/split",
      "trainable and total parameters",
      "feature shape",
      "effective batch and realized head/stem LRs",
      "layer-group mapping",
      "peak memory and distributed strategy",
      "final metric",
      "exit state"
    ],
    "comparability_rule": "no model-specific LR, layer decay, augmentation, layer selection, resolution, or task-head search",
    "retry_policy": "attempt first, isolate failures, then repair and retry only the affected logical job; memory-only changes must preserve optimization semantics"
