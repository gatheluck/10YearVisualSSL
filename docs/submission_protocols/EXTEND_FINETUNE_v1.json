{
  "protocol_id": "EXTEND_FINETUNE_v1",
  "version": "1.0",
  "status": "canonical",
  "track": "full_fine_tuning",
  "inherits": {
    "protocol": "EXTEND_LINEAR_v1",
    "fields": [
      "models",
      "dataset_policy",
      "datasets",
      "dataset paths",
      "splits",
      "input geometry",
      "epoch counts",
      "task heads",
      "loss definitions",
      "evaluation metrics"
    ]
  },
  "purpose": "Measure downstream adaptation by training the entire released backbone with the same minimum task head and schedule length used by EXTEND_LINEAR_v1.",
  "design_principle": "Preserve the dataset definition, task head, epoch count, and metric. Unfreeze the backbone and change only optimizer, LR, weight decay, warmup, layer-wise LR decay, regularizing augmentation, and memory strategy where end-to-end training requires it.",
  "models": [
    "clip",
    "siglip_giant",
    "sam3",
    "cradiov4_h",
    "dinov3_7b",
    "raev2_k7",
    "vjepa2_1",
    "vggt_omega"
  ],
  "execution": {
    "logical_job": "one model x one dataset x EXTEND_FINETUNE_v1 x seed 0",
    "seeds": [
      0
    ],
    "trials_per_cell": 1,
    "submission": "independent FT jobs; submit incrementally when sufficient resources are available",
    "dependency_rule": "do not wait for, launch, or chain LINEAR or ATTENTIVE jobs",
    "existing_result_rule": "reuse a valid BASIC5_FINETUNE_v1 seed-0 result for an equivalent Basic Five cell",
    "resume_rule": "resume an incomplete checkpoint under the same logical ID; never duplicate a healthy owner",
    "failure_isolation": "one failed dataset must not stop unrelated jobs"
  },
  "global_overrides": {
    "backbone_mode": "trainable",
    "backbone_gradients": true,
    "trainable_scope": [
      "all backbone parameters",
      "the unchanged EXTEND_LINEAR_v1 task head"
    ],
    "attention_reader": "absent; do not carry the AP reader into full fine-tuning",
    "normalization": "train affine parameters; update BatchNorm running statistics when present; SyncBN permitted",
    "feature_layer": "same canonical output and token-to-grid conversion as EXTEND_LINEAR_v1",
    "feature_cache": "forbidden",
    "memory_only_changes": [
      "AMP/bfloat16",
      "activation checkpointing",
      "gradient accumulation",
      "FSDP or equivalent parameter sharding",
      "smaller physical batch with preserved effective batch and LR"
    ],
    "forbidden_shortcuts": [
      "LoRA or other parameter-efficient tuning",
      "partial backbone freezing",
      "quantized or distilled replacement",
      "smaller-model substitution",
      "stronger task decoder",
      "model-specific hyperparameter sweep"
    ],
    "gradient_clipping": {
      "type": "global_norm",
      "max_norm": 1.0
    },
    "audit_level": "lightweight_attempt_first"
  },
  "parameter_groups": {
    "head_lr_multiplier": 1.0,
    "layer_decay_definition": "the latest backbone block has multiplier 1.0; multiply by layer_decay for each earlier block; embeddings/stem receive the smallest LR",
    "no_weight_decay": [
      "bias",
      "normalization affine parameters",
      "positional embeddings",
      "class/register/prefix tokens"
    ],
    "no_weight_decay_value": 0.0,
    "architecture_mapping": "map each released backbone's ordered blocks to depth groups deterministically and record the mapping"
  },
