    "checkpoint_rule": "report the final scheduled epoch; validation may be used only for diagnostics, not best-checkpoint selection",
    "aggregation": "report the single seed-0 score; do not report mean or standard deviation",
    "required_metadata": [
      "logical job ID",
      "model checkpoint identifier",
      "dataset version/path",
      "split",
      "recipe and overrides",
      "feature shape",
      "effective batch/LR",
      "final metric",
      "exit state"
    ],
    "failure_states": [
      "FAILED_RETRYABLE",
      "UNSUPPORTED_FEATURE",
      "MISSING_ANNOTATION",
      "OUT_OF_MEMORY",
      "WALLTIME"
    ],
    "retry_policy": "record the first attempt, diagnose after execution, and retry only the affected logical job; OOM may reduce physical batch while preserving effective batch and LR",
    "comparability_rule": "no model-specific feature-layer, resolution, head-capacity, or learning-rate search in the canonical table"
  }
