{
  "protocol_id": "EXTEND_LINEAR_v1",
  "version": "1.0",
  "status": "canonical",
  "track": "frozen_backbone_minimum_task_probe",
  "purpose": "Single-trial expanded downstream evaluation of released visual backbones across all currently trainable datasets in the expanded catalog.",
  "design_principle": "Keep the backbone fully frozen and use a standard-inspired, minimum-capacity task readout. Dataset-specific splits, heads, losses, schedules, and metrics override shared task-family recipes only where the dataset requires it.",
  "models": [
    "clip",
    "siglip_giant",
    "sam3",
    "cradiov4_h",
    "dinov3_7b",
    "raev2_k7",
    "vjepa2_1",
    "vggt_omega"
  ],
  "execution": {
    "logical_job": "one model x one dataset x EXTEND_LINEAR_v1 x seed 0",
    "seeds": [
      0
    ],
    "trials_per_cell": 1,
    "submission": "submit every eligible logical job without manual wave partitioning; let PBS queue excess jobs",
    "dependency_rule": "no LP-to-AP-to-FT chaining; this protocol launches LINEAR only",
    "resume_rule": "resume an incomplete checkpoint under the same logical job ID; never duplicate a healthy owner",
    "existing_result_rule": "reuse a valid BASIC5_LINEAR_v1 result when dataset, model, seed, head, split, and metric are equivalent",
    "failure_isolation": "a failed or unsupported cell must not stop unrelated jobs"
  },
  "global_rules": {
    "pretrained_weights": "released checkpoint as-is; no intermediate adaptation",
    "backbone_mode": "fully_frozen_eval",
    "backbone_gradients": false,
    "normalization_statistics": "frozen",
    "trainable_scope": "dataset head/readout only",
    "feature_rule": "use the canonical final feature supplied by the model adapter; no layer search, learned layer mixing, or model-specific hyperparameter sweep",
    "spatial_rule": "dense and correspondence tasks use final spatial tokens/features without global pooling",
    "temporal_rule": "video tasks use 16 uniformly segmented frames unless a dataset override is specified; image backbones pool per-frame features temporally",
    "precision": "AMP or bfloat16 permitted; numerically sensitive losses and metrics remain float32",
    "seed": 0,
    "audit_level": "lightweight_attempt_first",
    "required_preflight": [
      "dataset path and required annotation file can be opened",
      "class/label mapping is nonempty",
      "one mini-batch completes feature extraction, loss computation, and head-only backward",
      "backbone receives no gradients"
    ],
    "not_required_before_launch": [
      "multi-seed reproducibility",
      "full-dataset annotation audit",
      "strict canary certification",
      "model-specific hyperparameter search"
    ]
  },
  "recipes": {
    "image_cls_100": {
      "input": "224 train random-resized crop plus horizontal flip when label-preserving; 256 resize plus 224 center crop at evaluation; model normalization",
      "feature": "L2-normalized canonical final global feature",
      "head": "single linear classifier",
      "optimization": {
        "epochs": 100,
        "optimizer": "SGD",
        "base_lr": 0.1,
        "lr_reference_effective_batch": 256,
        "lr_scaling": "linear",
        "momentum": 0.9,
        "weight_decay": 0.0,
        "warmup": "none",
        "schedule": "cosine to 0"
      },
      "loss": "cross entropy",
      "metrics": [
        "top-1 accuracy",
        "top-5 accuracy when classes >= 5"
      ]
    },
    "image_cls_small_100": {
      "input": "resize grayscale or small images to 224, replicate grayscale to 3 channels, random crop/translation and label-preserving horizontal flip only",
      "feature": "L2-normalized canonical final global feature",
      "head": "single linear classifier",
      "optimization": {
        "epochs": 100,
        "optimizer": "SGD",
        "base_lr": 0.1,
        "lr_reference_effective_batch": 256,
        "lr_scaling": "linear",
        "momentum": 0.9,
        "weight_decay": 0.0,
        "warmup": "none",
        "schedule": "cosine to 0"
      },
      "loss": "cross entropy",
      "metrics": [
        "top-1 accuracy"
      ]
    },
    "image_multilabel_50": {
      "input": "224 random-resized crop; label-preserving horizontal flip; center-crop evaluation",
      "feature": "L2-normalized canonical final global feature",
      "head": "single linear multi-label classifier",
      "optimization": {
        "epochs": 50,
        "optimizer": "AdamW",
        "base_lr": 0.001,
        "lr_reference_effective_batch": 256,
        "lr_scaling": "linear",
        "weight_decay": 0.0001,
        "warmup": "5 epochs linear",
        "schedule": "cosine"
      },
      "loss": "binary cross entropy with logits",
      "metrics": [
        "mean average precision"
      ]
    },
    "video_cls_50": {
      "input": "16 uniformly segmented frames, temporally consistent 224 crop; center temporal/spatial evaluation; horizontal flip only when label-preserving",
      "feature": "native final video feature, or spatial mean per frame then temporal mean for image backbones",
      "head": "single linear classifier",
      "optimization": {
        "epochs": 50,
        "optimizer": "SGD",
        "base_lr": 0.1,
        "lr_reference_effective_batch": 256,
        "lr_scaling": "linear",
        "momentum": 0.9,
        "weight_decay": 0.0001,
        "warmup": "5 epochs linear from 1e-6",
        "schedule": "cosine to 0"
      },
      "loss": "cross entropy",
      "metrics": [
        "top-1 accuracy",
        "top-5 accuracy"
      ]
    },
    "video_multilabel_50": {
      "input": "16 uniformly segmented frames, temporally consistent 224 crop; center evaluation",
      "feature": "native final video feature, or spatial mean per frame then temporal mean",
      "head": "single linear multi-label classifier",
      "optimization": {
        "epochs": 50,
        "optimizer": "AdamW",
        "base_lr": 0.001,
        "lr_reference_effective_batch": 256,
        "lr_scaling": "linear",
        "weight_decay": 0.0001,
        "warmup": "5 epochs linear",
        "schedule": "cosine"
      },
      "loss": "binary cross entropy with logits",
      "metrics": [
        "mean average precision"
      ]
    },
    "detection_1x": {
      "input": "short side 800, long side <=1333; horizontal flip p=0.5",
      "feature": "final spatial/multiscale features; no global pooling",
      "head": "FPN plus Faster R-CNN RPN/RoIAlign/classifier/regressor",
      "optimization": {
        "epochs": 12,
        "optimizer": "SGD",
        "base_lr": 0.02,
        "lr_reference_effective_batch": 16,
        "lr_scaling": "linear",
        "momentum": 0.9,
        "weight_decay": 0.0001,
        "warmup": "500 iterations, factor 0.001",
        "schedule": "step x0.1 at epochs 8 and 11"
      },
      "loss": "standard Faster R-CNN losses",
      "metrics": [
        "bbox AP@[.50:.95]",
        "AP50",
        "AP75"
      ]
    },
    "instance_seg_1x": {
      "input": "short side 800, long side <=1333; horizontal flip p=0.5",
      "feature": "final spatial/multiscale features",
      "head": "FPN plus Mask R-CNN detection and mask heads",
      "optimization": {
        "epochs": 12,
        "optimizer": "SGD",
        "base_lr": 0.02,
        "lr_reference_effective_batch": 16,
        "lr_scaling": "linear",
        "momentum": 0.9,
        "weight_decay": 0.0001,
        "warmup": "500 iterations",
        "schedule": "step x0.1 at epochs 8 and 11"
      },
      "loss": "standard Mask R-CNN losses",
      "metrics": [
        "mask AP@[.50:.95]",
        "bbox AP@[.50:.95]"
      ]
    },
    "semantic_seg_20": {
      "input": "random scale [0.5,2.0], random 224 crop, horizontal flip p=0.5; single-scale evaluation",
      "feature": "final spatial tokens reshaped to 2-D grid",
      "head": "single 1x1 Conv and bilinear upsampling",
      "optimization": {
        "epochs": 20,
        "optimizer": "AdamW",
        "base_lr": 0.001,
        "lr_reference_effective_batch": 8,
        "lr_scaling": "linear",
        "weight_decay": 0.0001,
        "warmup": "1 epoch from 1e-6",
        "schedule": "cosine to 1e-6"
      },
      "loss": "pixel cross entropy with dataset ignore label",
      "metrics": [
        "mean IoU",
        "pixel accuracy"
      ]
    },
    "depth_30": {
      "input": "dataset-standard geometry resized/cropped to 224-compatible dimensions; horizontal flip when valid",
      "feature": "final spatial tokens reshaped to 2-D grid",
      "head": "single-channel 1x1 Conv, positive-depth parameterization, bilinear upsampling",
      "optimization": {
        "epochs": 30,
        "optimizer": "AdamW",
        "base_lr": 0.001,
        "lr_reference_effective_batch": 8,
        "lr_scaling": "linear",
        "weight_decay": 0.0001,
        "warmup": "1 epoch from 1e-6",
        "schedule": "cosine to 1e-6"
      },
      "loss": "valid-pixel scale-invariant log-depth",
      "metrics": [
        "RMSE",
        "AbsRel",
        "delta1"
      ]
    },
    "pose_30": {
      "input": "person crops and heatmap geometry from the dataset-standard top-down protocol",
      "feature": "final spatial features",
      "head": "single deconvolution-free 1x1 keypoint heatmap head with bilinear upsampling",
      "optimization": {
        "epochs": 30,
        "optimizer": "AdamW",
        "base_lr": 0.001,
        "lr_reference_effective_batch": 64,
        "lr_scaling": "linear",
        "weight_decay": 0.0001,
        "warmup": "1 epoch",
        "schedule": "cosine"
      },
      "loss": "keypoint heatmap MSE",
      "metrics": [
        "dataset-standard keypoint AP or PCKh"
      ]
    },
    "tracking_30": {
      "input": "dataset-standard template/search frame pairs at 224-compatible resolution",
      "feature": "frozen spatial tokens from both frames",
      "head": "shared linear projection plus correlation and linear box/mask prediction",
      "optimization": {
        "epochs": 30,
        "optimizer": "AdamW",
        "base_lr": 0.001,
        "lr_reference_effective_batch": 64,
        "lr_scaling": "linear",
        "weight_decay": 0.0001,
        "warmup": "1 epoch",
        "schedule": "cosine"
      },
      "loss": "dataset-standard localization loss",
      "metrics": [
        "dataset-standard tracking primary metric"
      ]
    },
    "flow_30": {
      "input": "paired frames with dataset-standard crop at dimensions divisible by patch size",
      "feature": "frozen spatial tokens from both frames",
      "head": "parameter-free correlation plus shallow linear flow regression/upsampling head",
      "optimization": {
        "epochs": 30,
        "optimizer": "AdamW",
        "base_lr": 0.001,
        "lr_reference_effective_batch": 16,
        "lr_scaling": "linear",
        "weight_decay": 0.0001,
        "warmup": "1 epoch",
        "schedule": "cosine"
      },
      "loss": "robust endpoint loss on valid pixels",
      "metrics": [
        "EPE",
        "dataset-standard outlier rate"
      ]
    },
    "matching_30": {
      "input": "paired views resized with aspect ratio preserved; longest side 800 unless dataset tooling fixes another size",
      "feature": "L2-normalized frozen spatial descriptors",
      "head": "shared linear descriptor projection; mutual-nearest-neighbor matching; no trainable geometric solver",
      "optimization": {
        "epochs": 30,
        "optimizer": "AdamW",
        "base_lr": 0.001,
        "lr_reference_effective_batch": 64,
        "lr_scaling": "linear",
        "weight_decay": 0.0001,
        "warmup": "1 epoch",
        "schedule": "cosine"
      },
      "loss": "contrastive correspondence loss using available geometry",
      "metrics": [
        "matching accuracy/AUC at dataset-standard thresholds"
      ]
    },
    "localization_30": {
      "input": "single-view 224 center crop for global retrieval plus spatial descriptors for verification",
      "feature": "frozen global and spatial final features",
      "head": "linear descriptor projection; standard nearest-neighbor retrieval and fixed geometric verification",
      "optimization": {
        "epochs": 30,
        "optimizer": "AdamW",
        "base_lr": 0.001,
        "lr_reference_effective_batch": 128,
        "lr_scaling": "linear",
        "weight_decay": 0.0001,
        "warmup": "1 epoch",
        "schedule": "cosine"
      },
      "loss": "supervised contrastive place/pose loss",
      "metrics": [
        "dataset-standard localization recall"
      ]
    },
    "visual_reasoning_50": {
      "input": "up to 16 frames for video or 224 image; use provided question/program tokens only as fixed inputs",
      "feature": "frozen visual tokens",
      "head": "one dataset-shared linear projection plus the smallest existing repository task head; visual backbone remains frozen",
      "optimization": {
        "epochs": 50,
        "optimizer": "AdamW",
        "base_lr": 0.001,
        "lr_reference_effective_batch": 128,
        "lr_scaling": "linear",
        "weight_decay": 0.0001,
        "warmup": "5 epochs",
        "schedule": "cosine"
      },
      "loss": "dataset-standard answer/state classification loss",
      "metrics": [
        "dataset-standard accuracy"
      ]
    },
    "action_detection_12": {
      "input": "16-frame clip centered on annotated keyframe, short side 256, 224 crop",
      "feature": "frozen spatiotemporal features",
      "head": "frozen/person boxes plus RoIAlign and linear multi-label action classifier",
      "optimization": {
        "epochs": 12,
        "optimizer": "SGD",
        "base_lr": 0.02,
        "lr_reference_effective_batch": 64,
        "lr_scaling": "linear",
        "momentum": 0.9,
        "weight_decay": 0.0001,
        "warmup": "1 epoch",
        "schedule": "step at epochs 8 and 11"
      },
      "loss": "binary cross entropy with logits",
      "metrics": [
        "frame mAP"
      ]
    }
  },
  "dataset_policy": {
    "included_dataset_configs": 81,
    "basic5_reusable_configs": 5,
    "new_configs_per_model": 76,
    "new_logical_jobs_for_all_eight_models": 608,
    "recommended_incremental_submission": "submit one or more complete 76-dataset model campaigns when nodes are available; for example, two models equal 152 logical jobs",
    "domainnet": "one dataset config using all six official domains; do not create separate infograph/quickdraw/real/sketch jobs",
    "industrial_iseg": "one dataset config; insp-wqisd is an internal subset, not another benchmark job",
    "excluded": {
      "scale_or_redundancy": [
        "ImageNet-21k",
        "ImageNet-100",
        "Kinetics-700",
        "FractalDB-WN60",
        "Places30"
      ],
      "no_new_training_requested": [
        "CIFAR-10C",
        "CIFAR-100C",
        "ImageNet-A",
        "ImageNet-C",
        "ImageNet-R",
        "ImageNet-Sketch",
        "ObjectNet",
        "Places365-past"
      ],
      "no_supervised_downstream_target": [
        "PASS"
      ]
    },
    "included_special_cases": {
      "ImageNet-1percent": "independent 100-epoch linear probe on the official 1% labeled training subset; evaluate on full ILSVRC2012 validation",
      "ImageNet-10percent": "independent 100-epoch linear probe on the official 10% labeled training subset; evaluate on full ILSVRC2012 validation",
      "Kinetics-400": "selected instead of Kinetics-700 for broader frozen-evaluation comparability and lower cost"
    }
  },
