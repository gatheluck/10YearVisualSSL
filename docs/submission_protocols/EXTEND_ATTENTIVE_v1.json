        "lr_scaling": "linear",
        "weight_decay": 0.05,
        "betas": [
          0.9,
          0.999
        ],
        "warmup": "5 epochs from 1e-6",
        "schedule": "cosine to 1e-6",
        "layer_decay": 1.0
      },
      "augmentation": "unchanged from EXTEND_LINEAR_v1"
    },
