  "dataset_resolution": "Resolve every dataset entry from EXTEND_LINEAR_v1, retain its split/path/input/head/loss/metric, and apply the matching recipe override above. Dataset-specific overrides in EXTEND_LINEAR_v1 take precedence unless they would unfreeze or replace the backbone.",
  "reporting": {
    "checkpoint_rule": "final scheduled epoch",
    "aggregation": "single seed-0 score; no mean or standard deviation",
    "required_metadata": [
      "logical and physical job IDs",
      "checkpoint",
      "dataset/version/split",
      "reader type and parameter count",
      "unchanged task head",
      "feature shape",
      "effective batch/LR",
      "backbone gradient check",
      "final metric",
      "exit state"
    ],
    "comparability_rule": "no model-specific reader size, query count, layer choice, resolution, or hyperparameter search",
    "retry_policy": "attempt first, isolate failures, then repair and retry only the affected logical job"
  }
